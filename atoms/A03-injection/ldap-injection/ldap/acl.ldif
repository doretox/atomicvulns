# Applied to the directory config at image build time (see ldap/Dockerfile).
#
# The only change from OpenLDAP's default ACL is on userPassword: the service
# account cn=svc is granted `search` access, so the login's naive filter
# (&(uid=...)(userPassword=...)) can actually match on userPassword when bound as
# svc. Everyone else keeps the default (self write; anonymous auth for binding;
# no one else can read/search it). This is deliberately the minimum access the
# search-based login needs -- the app is NOT the directory admin, so the auth
# bypass in the walkthrough is LDAP injection, not an over-privileged bind.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword by self write by dn.exact="cn=svc,dc=example,dc=com" search by anonymous auth by * none
olcAccess: {1}to attrs=shadowLastChange by self write by * read
olcAccess: {2}to * by * read
